# Sample for live-test keys. Copy to a file named .env (git-ignored) and fill in the values yourself.
#   cp env.sample .env
# Names have no VITE_ prefix on purpose: Vite must never inject them into the build.
# Test scripts read them only via: node --env-file=.env <script>
# The app itself keeps its own key in browser IndexedDB, entered through Settings.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
